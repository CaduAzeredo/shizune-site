{
  "name": "shizune-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/pos-build.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{ts,json,html}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "check": "node scripts/check-contrast.mjs && node scripts/check-motion.mjs && node scripts/check-slop.mjs",
    "peso": "node scripts/check-peso.mjs",
    "e2e": "node scripts/e2e.mjs",
    "ficha": "node scripts/ficha.mjs",
    "arte": "node scripts/arte.mjs",
    "portao": "node scripts/check-contrast.mjs && node scripts/check-motion.mjs && node scripts/check-slop.mjs && tsc --noEmit -p tsconfig.app.json && eslint . && tsc -b && vite build && node scripts/pos-build.mjs && node scripts/check-peso.mjs && node scripts/e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.11.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "playwright-core": "^1.57.0",
    "prettier": "^3.9.5",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
